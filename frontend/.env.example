# =============================================================================
# AdvD Frontend Environment Configuration Template
# For Netlify deployment, configure these variables in the Netlify Dashboard
# under Site configuration > Environment variables.
# =============================================================================

# Backend API Public URL
# In local development: leave blank to use the Vite local proxy (/api -> http://127.0.0.1:5000)
# In production on Netlify: set this to your Render backend URL (e.g. https://advd-api.onrender.com)
VITE_API_URL=

