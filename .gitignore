# Root level gitignore for AdvD

# Dependencies
node_modules/
*/node_modules/

# Production builds
dist/
*/dist/
build/
*/build/

# Environment files and credentials
.env
*.env
.env.*
.env.local
.env.*.local
!.env.example
!*/.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# File uploads and temporary directories
uploads/
*/uploads/*
!*/uploads/.gitkeep
!*/uploads/documents/
!*/uploads/documents/.gitkeep
tmp/
temp/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System Files
.DS_Store
Thumbs.db

# IDE & Editor files
.vscode/
.idea/

