# Root level gitignore for AdvD

# Dependencies
node_modules/
*/node_modules/

# Production builds
dist/
*/dist/
build/
*/build/

# Environment files
.env
*.env
.env.local
.env.*.local
!.env.example
!*/.env.example

# File uploads and temporary directories
uploads/
*/uploads/
tmp/
temp/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System Files
.DS_Store
Thumbs.db

# IDE & Editor files
.vscode/
.idea/

