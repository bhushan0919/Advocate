# =============================================================================
# AdvD Backend Environment Configuration Template
# For Render deployment, configure these variables in the Render Dashboard.
# =============================================================================

# Server Port (Render injects PORT dynamically in production, defaults to 5000 locally)
PORT=5000

# Environment Mode ('development' | 'production' | 'test')
NODE_ENV=development

# Database Connection (MongoDB Atlas connection string for production, or local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/advd?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/advd

# JWT Authentication Secrets (Generate secure random 64-char strings for production)
JWT_ACCESS_SECRET=your_super_secure_jwt_access_secret_key_change_in_production
JWT_REFRESH_SECRET=your_super_secure_jwt_refresh_secret_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cross-Origin Resource Sharing (CORS) Configuration
# In production on Render, set this to your Netlify frontend URL.
# Supports comma-separated origins, e.g.: https://advd.netlify.app,https://yourcustomdomain.com
CORS_ORIGIN=http://localhost:5173

# Frontend Web Application Base URL (Used for generating Clerk invitations & reset links)
# In production on Render, set this to: https://advd.netlify.app
APP_URL=http://localhost:5173

# Backend API Public URL (Used for webhook callbacks, self-referential links, and logs)
# In production on Render, set this to: https://advd-api.onrender.com
API_URL=http://localhost:5000

# =============================================================================
# Cloudinary Configuration (Cloud Image Storage for Avatars and Files)
# Get credentials from your Cloudinary Dashboard: https://console.cloudinary.com
# =============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
